rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveSecurityStaff() {
      return isSignedIn() &&
          exists(
            /databases/$(database)/documents/security_staff/$(request.auth.uid)
          ) &&
          get(
            /databases/$(database)/documents/security_staff/$(request.auth.uid)
          ).data.isActive == true;
    }

    function currentStudentId() {
      return request.auth.token.studentId is string
          ? request.auth.token.studentId
          : request.auth.uid;
    }

    function isActiveLecturerById(lecturerId) {
      return isSignedIn() &&
          lecturerId is string &&
          lecturerId.size() > 0 &&
          exists(
            /databases/$(database)/documents/external_lecturers/$(lecturerId)
          ) &&
          get(
            /databases/$(database)/documents/external_lecturers/$(lecturerId)
          ).data.isActive == true &&
          (
            !(get(
                /databases/$(database)/documents/external_lecturers/$(lecturerId)
              ).data.role is string) ||
            get(
              /databases/$(database)/documents/external_lecturers/$(lecturerId)
            ).data.role == 'lecturer'
          ) &&
          request.auth.token.email is string &&
          get(
            /databases/$(database)/documents/external_lecturers/$(lecturerId)
          ).data.email == request.auth.token.email;
    }

    function isLecturerByClaimOrId(lecturerId) {
      return isSignedIn() &&
          lecturerId is string &&
          (
            (request.auth.token.lecturerId is string &&
              request.auth.token.lecturerId == lecturerId) ||
            isActiveLecturerById(lecturerId)
          );
    }

    function isBluetoothLecturerOwnerById(lecturerId) {
      let lecturer = get(
        /databases/$(database)/documents/external_lecturers/$(lecturerId)
      );
      return isSignedIn() &&
          lecturerId is string &&
          lecturerId.size() > 0 &&
          exists(
            /databases/$(database)/documents/external_lecturers/$(lecturerId)
          ) &&
          lecturer.data.isActive == true &&
          (
            !(lecturer.data.role is string) ||
            lecturer.data.role == 'lecturer'
          ) &&
          (
            (
              request.auth.token.lecturerId is string &&
              request.auth.token.lecturerId == lecturerId
            ) ||
            (
              request.auth.token.email is string &&
              lecturer.data.email == request.auth.token.email
            ) ||
            (
              lecturer.data.linkedUserUid is string &&
              lecturer.data.linkedUserUid == request.auth.uid
            )
          );
    }

    function isSectionAssignedToLecturer(sectionId, lecturerId) {
      // Some projects store lecturer ownership in sections. If present, enforce it.
      // If not present in schema, rely on strict lecturer identity checks above.
      return sectionId is string &&
          exists(/databases/$(database)/documents/sections/$(sectionId)) &&
          (
            !(get(/databases/$(database)/documents/sections/$(sectionId)).data.lecturerId is string) ||
            get(/databases/$(database)/documents/sections/$(sectionId)).data.lecturerId == lecturerId
          );
    }

    function isStudent() {
      return isSignedIn() &&
          (
            request.auth.token.role == 'student' ||
            request.auth.token.studentId is string ||
            exists(
              /databases/$(database)/documents/external_students/$(currentStudentId())
            )
          );
    }

    function hasQrSessionRequiredFields(data) {
      return data.keys().hasAll([
        'sessionId',
        'sectionId',
        'courseCode',
        'courseName',
        'lecturerId',
        'lectureDate',
        'lectureStartTime',
        'lectureEndTime',
        'dateKey',
        'attendanceMethod',
        'isOpen',
        'currentTokenId',
        'tokenVersion',
        'generatedAt',
        'expiresAt',
        'numericCode',
        'numericCodeGeneratedAt',
        'numericCodeExpiresAt',
        'codeVersion',
        'createdAt',
        'updatedAt',
      ]);
    }

    function isValidQrSessionCreate(sessionId) {
      let data = request.resource.data;
      return hasQrSessionRequiredFields(data) &&
          data.sessionId == sessionId &&
          data.sessionId is string &&
          data.sectionId is string &&
          data.currentTokenId is string &&
          data.tokenVersion is number &&
          data.numericCode is string &&
          data.numericCodeGeneratedAt is timestamp &&
          data.numericCodeExpiresAt is timestamp &&
          data.codeVersion is number &&
          data.isOpen is bool &&
          data.attendanceMethod == 'qr' &&
          isLecturerByClaimOrId(data.lecturerId) &&
          isSectionAssignedToLecturer(data.sectionId, data.lecturerId);
    }

    function isValidQrSessionUpdate() {
      let data = request.resource.data;
      let old = resource.data;
      return data.lecturerId == old.lecturerId &&
          data.sessionId == old.sessionId &&
          data.sectionId == old.sectionId &&
          data.attendanceMethod == 'qr' &&
          data.currentTokenId is string &&
          data.tokenVersion is number &&
          data.numericCode is string &&
          data.numericCodeGeneratedAt is timestamp &&
          data.numericCodeExpiresAt is timestamp &&
          data.codeVersion is number &&
          data.isOpen is bool;
    }

    function canReadQrSession() {
      // Student enrollment-doc IDs are not deterministic in rules, so
      // signed-in read is kept for scanner validation. Write paths stay strict.
      return isSignedIn();
    }

    function hasQrRecordRequiredFields(data) {
      return data.keys().hasAll([
        'recordId',
        'sessionId',
        'sectionId',
        'studentId',
        'studentDocId',
        'studentName',
        'studentEmail',
        'courseCode',
        'courseName',
        'lectureDate',
        'lectureStartTime',
        'lectureEndTime',
        'attendanceMethod',
        'status',
        'createdAt',
        'updatedAt',
      ]) &&
          (
            data.keys().hasAny(['attendanceTime']) ||
            data.keys().hasAny(['scannedAt'])
          );
    }

    function hasQrStudentProfileProof(data) {
      return data.studentDocId is string &&
          data.studentDocId.size() > 0 &&
          exists(
            /databases/$(database)/documents/external_students/$(data.studentDocId)
          ) &&
          (
            !(get(
                /databases/$(database)/documents/external_students/$(data.studentDocId)
              ).data.studentId is number) ||
            get(
              /databases/$(database)/documents/external_students/$(data.studentDocId)
            ).data.studentId == data.studentId
          );
    }

    function hasQrEnrollmentProof(data) {
      return data.studentDocId is string &&
          data.sectionId is string &&
          exists(
            /databases/$(database)/documents/student_section_enrollments/$(data.studentDocId + '_' + data.sectionId)
          ) &&
          get(
            /databases/$(database)/documents/student_section_enrollments/$(data.studentDocId + '_' + data.sectionId)
          ).data.sectionId == data.sectionId &&
          get(
            /databases/$(database)/documents/student_section_enrollments/$(data.studentDocId + '_' + data.sectionId)
          ).data.studentDocId == data.studentDocId &&
          (
            !(get(
                /databases/$(database)/documents/student_section_enrollments/$(data.studentDocId + '_' + data.sectionId)
              ).data.studentId is number) ||
            get(
              /databases/$(database)/documents/student_section_enrollments/$(data.studentDocId + '_' + data.sectionId)
            ).data.studentId == data.studentId
          ) &&
          get(
            /databases/$(database)/documents/student_section_enrollments/$(data.studentDocId + '_' + data.sectionId)
          ).data.isActive != false;
    }

    function hasValidQrSessionProof(data) {
      return data.sessionId is string &&
          exists(
            /databases/$(database)/documents/qr_attendance_sessions/$(data.sessionId)
          ) &&
          get(
            /databases/$(database)/documents/qr_attendance_sessions/$(data.sessionId)
          ).data.sectionId == data.sectionId &&
          get(
            /databases/$(database)/documents/qr_attendance_sessions/$(data.sessionId)
          ).data.isOpen == true &&
          get(
            /databases/$(database)/documents/qr_attendance_sessions/$(data.sessionId)
          ).data.attendanceMethod == 'qr';
    }

    function isValidQrRecordCreate(recordId) {
      let data = request.resource.data;
      return hasQrRecordRequiredFields(data) &&
          data.recordId == recordId &&
          data.recordId is string &&
          data.sessionId is string &&
          data.sectionId is string &&
          data.studentId is number &&
          data.studentDocId is string &&
          data.studentName is string &&
          data.studentEmail is string &&
          data.courseCode is string &&
          data.courseName is string &&
          data.lectureDate is timestamp &&
          data.lectureStartTime is string &&
          data.lectureEndTime is string &&
          data.attendanceMethod == 'qr' &&
          (data.status == 'present' || data.status == 'late') &&
          data.recordId.matches('^' + data.sessionId + '_[0-9]+$') &&
          hasValidQrSessionProof(data) &&
          hasQrStudentProfileProof(data) &&
          hasQrEnrollmentProof(data);
    }

    function canReadQrRecord() {
      return isSignedIn();
    }

    function hasBluetoothSessionRequiredFields(data) {
      return data.keys().hasAll([
        'sessionId',
        'sectionId',
        'courseCode',
        'courseName',
        'lecturerId',
        'lectureDate',
        'lectureStartTime',
        'lectureEndTime',
        'dateKey',
        'attendanceMethod',
        'isOpen',
        'bluetoothSessionToken',
        'tokenVersion',
        'generatedAt',
        'expiresAt',
        'advertisedServiceUuid',
        'minRssi',
        'proximityPolicy',
        'attendanceCount',
        'createdAt',
        'updatedAt',
      ]);
    }

    function isValidBluetoothSessionCreate(sessionId) {
      let data = request.resource.data;
      return hasBluetoothSessionRequiredFields(data) &&
          data.sessionId == sessionId &&
          data.sessionId is string &&
          data.sectionId is string &&
          data.bluetoothSessionToken is string &&
          data.tokenVersion is number &&
          data.generatedAt is timestamp &&
          data.expiresAt is timestamp &&
          data.advertisedServiceUuid is string &&
          data.minRssi is number &&
          data.proximityPolicy is string &&
          data.attendanceCount is number &&
          data.isOpen is bool &&
          data.attendanceMethod == 'bluetooth' &&
          isBluetoothLecturerOwnerById(data.lecturerId) &&
          isSectionAssignedToLecturer(data.sectionId, data.lecturerId);
    }

    function isValidBluetoothSessionUpdate() {
      let data = request.resource.data;
      let old = resource.data;
      return data.lecturerId == old.lecturerId &&
          data.sessionId == old.sessionId &&
          data.sectionId == old.sectionId &&
          data.courseCode == old.courseCode &&
          data.courseName == old.courseName &&
          data.section == old.section &&
          data.lectureDate == old.lectureDate &&
          data.lectureStartTime == old.lectureStartTime &&
          data.lectureEndTime == old.lectureEndTime &&
          data.dateKey == old.dateKey &&
          data.attendanceMethod == 'bluetooth' &&
          data.advertisedServiceUuid == old.advertisedServiceUuid &&
          data.attendanceCount == old.attendanceCount &&
          data.bluetoothSessionToken is string &&
          data.tokenVersion is number &&
          data.generatedAt is timestamp &&
          data.expiresAt is timestamp &&
          data.advertisedServiceUuid is string &&
          data.minRssi is number &&
          data.proximityPolicy is string &&
          data.attendanceCount is number &&
          data.isOpen is bool &&
          isBluetoothLecturerOwnerById(old.lecturerId);
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Female security staff profiles (used by security settings + admin profile image manager).
    match /security_staff/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Public read for pre-seeded external lecturers.
    match /external_lecturers/{lecturerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read for pre-seeded external students.
    match /external_students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student notification UI state (read/hidden/lastSeen) stored per auth user.
    // This avoids writing to external_students (admin-only).
    match /student_notification_prefs/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Security gate metadata used to scope scans to assigned gates.
    match /campus_gates/{gateId} {
      allow read: if isActiveSecurityStaff();
      allow write: if isAdmin();
    }

    // Rejection reasons shown in the security verification dialog.
    match /security_rejection_reasons/{reasonId} {
      allow read: if isActiveSecurityStaff();
      allow write: if isAdmin();
    }

    // Lecture schedules managed by admin dashboard.
    match /lecture_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses catalog.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course sections.
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student enrollment into sections.
    match /student_section_enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Attendance records (للشات بوت وواجهة الحضور — قراءة للجميع، الكتابة للأدمن فقط).
    match /attendance_records/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // قواعد الحرمان والنسب (قراءة للشات بوت والواجهات).
    match /academic_rules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // التقويم الأكاديمي (أسابيع الفصل — للشات بوت).
    match /academic_calendar/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Academic terms + weeks + exceptions.
    match /academic_terms/{termId} {
      allow read: if true;
      allow write: if isAdmin();

      match /weeks/{weekId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /calendar_exceptions/{exceptionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Manual attendance sessions (one per section/day/lecture start time).
    match /manual_attendance_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Manual attendance records — قراءة للشات بوت وواجهة الحضور (الطلاب يدخلون بالإيميل بدون Firebase Auth).
    match /manual_attendance_records/{recordId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // QR attendance sessions: lecturer-owned session/token lifecycle.
    // Students can read sessions for QR validation, but cannot modify session tokens.
    match /qr_attendance_sessions/{sessionId} {
      allow read: if canReadQrSession();
      // Any active registered lecturer can create their own QR session.
      allow create: if isValidQrSessionCreate(sessionId);
      // Students cannot update sessions/tokens.
      allow update: if isActiveLecturerById(resource.data.lecturerId) &&
          isValidQrSessionUpdate();
      // Block delete for audit integrity.
      allow delete: if false;
    }

    // QR attendance records: students can create only their own record.
    // No deletes to preserve audit integrity.
    match /qr_attendance_records/{recordId} {
      allow get: if canReadQrRecord() && recordId.matches('^.+_[0-9]+$');
      allow list: if false;
      allow create: if isSignedIn() && isValidQrRecordCreate(recordId);
      allow update, delete: if false;
    }

    // NFC attendance records (coming soon).
    match /nfc_attendance_records/{recordId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // NFC attendance sessions (lecturer opens/closes attendance session).
    match /nfc_attendance_sessions/{sessionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Bluetooth attendance sessions: lecturer-owned session/token lifecycle.
    // No BLE scan/record writes are enabled in Phase 1.
    match /bluetooth_attendance_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isValidBluetoothSessionCreate(sessionId);
      allow update: if isValidBluetoothSessionUpdate();
      allow delete: if false;
    }

    // Student app notifications generated from lecturer actions.
    match /student_notifications/{notificationId} {
      // Students log in by email (without Firebase Auth), so read must remain public
      // like manual_attendance_records; filtering by studentId happens in client query.
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Lecturer confirmation notifications (e.g., students have been notified).
    match /lecturer_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Official lecture action ledger (delay/cancel per section/date/start-time).
    match /lecture_actions/{actionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Formal excuse requests (student creates — may require separate create rules when shipped).
    match /excuse_requests/{requestId} {
      // Student submits; lecturer/admin reviews.
      // For now: allow create for any signed-in Firebase session (anonymous is OK).
      allow create: if isSignedIn();
      allow read, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Female security accepted/rejected gate scan history.
    match /student_gate_scans/{scanId} {
      allow read: if isActiveSecurityStaff();
      allow create: if isActiveSecurityStaff();
      allow update: if isActiveSecurityStaff();
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
