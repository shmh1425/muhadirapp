rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public read for pre-seeded external lecturers.
    match /external_lecturers/{lecturerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read for pre-seeded external students.
    match /external_students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lecture schedules managed by admin dashboard.
    match /lecture_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses catalog.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course sections.
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student enrollment into sections.
    match /student_section_enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Manual attendance sessions (one per section/day/lecture start time).
    match /manual_attendance_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Manual attendance records per student per session.
    match /manual_attendance_records/{recordId} {
      allow read, write: if isSignedIn();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
