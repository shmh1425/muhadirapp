rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveSecurityStaff() {
      return isSignedIn() &&
          exists(
            /databases/$(database)/documents/security_staff/$(request.auth.uid)
          ) &&
          get(
            /databases/$(database)/documents/security_staff/$(request.auth.uid)
          ).data.isActive == true;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Female security staff profiles (used by security settings + admin profile image manager).
    match /security_staff/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Public read for pre-seeded external lecturers.
    match /external_lecturers/{lecturerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read for pre-seeded external students.
    match /external_students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lecture schedules managed by admin dashboard.
    match /lecture_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses catalog.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course sections.
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student enrollment into sections.
    match /student_section_enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Attendance records (للشات بوت وواجهة الحضور — قراءة للجميع، الكتابة للأدمن فقط).
    match /attendance_records/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // قواعد الحرمان والنسب (قراءة للشات بوت والواجهات).
    match /academic_rules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // التقويم الأكاديمي (أسابيع الفصل — للشات بوت).
    match /academic_calendar/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Academic terms + weeks + exceptions.
    match /academic_terms/{termId} {
      allow read: if true;
      allow write: if isAdmin();

      match /weeks/{weekId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /calendar_exceptions/{exceptionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Manual attendance sessions (one per section/day/lecture start time).
    match /manual_attendance_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Manual attendance records — قراءة للشات بوت وواجهة الحضور (الطلاب يدخلون بالإيميل بدون Firebase Auth).
    match /manual_attendance_records/{recordId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // QR Code attendance records (coming soon).
    match /qr_attendance_records/{recordId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // NFC attendance records (coming soon).
    match /nfc_attendance_records/{recordId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Student app notifications generated from lecturer actions.
    match /student_notifications/{notificationId} {
      // Students log in by email (without Firebase Auth), so read must remain public
      // like manual_attendance_records; filtering by studentId happens in client query.
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Lecturer confirmation notifications (e.g., students have been notified).
    match /lecturer_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Formal excuse requests (student creates — may require separate create rules when shipped).
    match /excuse_requests/{requestId} {
      // Student submits; lecturer/admin reviews.
      // For now: allow create for any signed-in Firebase session (anonymous is OK).
      allow create: if isSignedIn();
      allow read, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Female security accepted/rejected gate scan history.
    match /student_gate_scans/{scanId} {
      allow read: if isActiveSecurityStaff();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
